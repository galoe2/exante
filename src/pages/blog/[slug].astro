---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogListing from '../../components/BlogListing.astro';
import Newsletter from '../../components/Newsletter.astro';
import { fmtDate, readingMinutes, RUBRICHE, rubricaSlug } from '../../lib/utils';

// Un'unica route dinamica serve sia le pagine rubrica (/blog/mercati/)
// sia gli articoli (/blog/<slug>/): così gli URL restano puliti.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return [
    ...RUBRICHE.map((r) => ({
      params: { slug: rubricaSlug(r) },
      props: { type: 'rubrica' as const, active: r, post: undefined },
    })),
    ...posts.map((post) => ({
      params: { slug: post.id },
      props: { type: 'post' as const, active: '', post },
    })),
  ];
}

interface Props {
  type: 'rubrica' | 'post';
  active: string;
  post?: CollectionEntry<'blog'>;
}

const { type, active, post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const Content = type === 'post' && post ? (await render(post)).Content : null;
---

{
  type === 'rubrica' ? (
    <Base title={`${active.charAt(0)}${active.slice(1).toLowerCase()} — Blog — Ex Ante`} active="blog">
      <BlogListing active={active} />
    </Base>
  ) : (
    <Base
      title={`${post!.data.title} — Ex Ante`}
      description={post!.data.abstract}
      active="blog"
      ogImage={`og/${post!.id}.png`}
    >
      <div class="container-narrow page">
        <a class="back" href={`${base}/blog/`}>
          ← Tutti gli articoli
        </a>
        <div class="meta">
          <span class="chip-rubrica">{post!.data.rubrica}</span>
          <span>{fmtDate(post!.data.date).toLowerCase()}</span>
          <span class="sep">·</span>
          <span>{readingMinutes(post!)} min di lettura</span>
        </div>
        <h1>{post!.data.title}</h1>
        <p class="lead">{post!.data.abstract}</p>
        <div class="divider" />

        <div class="article-body">{Content && <Content />}</div>

        {post!.data.report && (
          <a class="report-link btn-secondary" href={`${base}${post!.data.report}`}>
            Apri il report completo →
          </a>
        )}

        {post!.data.rubrica === 'MERCATI' && (
          <div class="empty-state" style="margin-top:44px; max-width:none;">
            <span class="nota">NOTA</span>
            <span>
              Questo contenuto ha scopo informativo e non costituisce consulenza finanziaria.
            </span>
          </div>
        )}

        <div style="margin-top:36px;">
          <Newsletter variant="compact" />
        </div>
      </div>
    </Base>
  )
}

<style>
  .page { padding-top: 56px; padding-bottom: 80px; }
  .back {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .back:hover { color: var(--text); }
  .meta {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin: 32px 0 18px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
  }
  .sep { color: var(--border-strong); }
  h1 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(30px, 4.5vw, 42px);
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: pretty;
  }
  .lead {
    margin: 20px 0 0;
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .divider {
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }
  .report-link { margin-top: 8px; }
</style>
