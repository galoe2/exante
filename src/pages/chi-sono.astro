---
import Base from '../layouts/Base.astro';

// Pagina volutamente vuota: la biografia verrà inserita in seguito.
// La versione completa (bio, percorso, formazione, skill) è nella history git
// (commit iniziale) e nel design handoff, pronta da ripristinare e personalizzare.
---

<Base title="Chi sono — Ex Ante" active="chi-sono">
  <div class="container page">
    <h1>Chi sono</h1>
    <div class="kicker" style="letter-spacing:0.12em; margin-bottom:28px;">
      GENNARO ALOE
    </div>
    <div class="empty">
      <span class="nota">IN ARRIVO</span>
      <span>Questa pagina è in preparazione.</span>
    </div>
  </div>
</Base>

<style>
  .page { padding-top: 72px; padding-bottom: 96px; }
  h1 {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: clamp(32px, 4.5vw, 44px);
    letter-spacing: -0.01em;
  }
  .empty {
    border: 1px solid var(--border-strong);
    background: var(--bg-panel);
    padding: 32px;
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 620px;
  }
  .nota {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--accent);
    white-space: nowrap;
  }
</style>
