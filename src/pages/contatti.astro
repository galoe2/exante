---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';

// Aggiornare con i link reali.
const contacts = [
  { label: 'LinkedIn', value: 'linkedin.com/in/gennaro-aloe', href: 'https://linkedin.com/in/gennaro-aloe' },
  { label: 'GitHub', value: 'github.com/gennaroaloe', href: 'https://github.com/gennaroaloe' },
  { label: 'Email', value: 'gennaro@ex-ante.it', href: 'mailto:gennaro@ex-ante.it' },
];
---

<Base title="Contatti — Ex Ante" active="contatti">
  <div class="container-narrow page">
    <h1>Contatti</h1>

    <div class="bio card-surface">
      <p>
        Ex Ante è il progetto di <strong>Gennaro Aloe</strong> e nasce da una passione: i mercati
        finanziari letti attraverso i dati. Il focus è l'analisi delle
        <strong>rotazioni settoriali</strong>, gli <strong>ETF</strong> e le
        <strong>azioni</strong> — capire dove si sposta il capitale prima che diventi consenso,
        con metodo quantitativo e tesi scritte in anticipo, mai col senno di poi.
      </p>
    </div>

    <p class="lead">Per proposte di collaborazione, domande sui modelli o due chiacchiere sui mercati:</p>

    <div class="list">
      {
        contacts.map((c) => (
          <a class="row" href={c.href}>
            <span class="label">{c.label}</span>
            <span class="value">{c.value}</span>
            <span class="arrow">→</span>
          </a>
        ))
      }
    </div>
    <div style="margin-top:44px;">
      <Newsletter variant="compact" />
    </div>
  </div>
</Base>

<style>
  .page { padding-top: 64px; padding-bottom: 80px; }
  h1 {
    margin: 0 0 28px;
    font-weight: 800;
    font-size: clamp(34px, 4.5vw, 44px);
    letter-spacing: -0.03em;
  }
  .bio {
    padding: 26px 30px;
    margin-bottom: 36px;
  }
  .bio p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--text-body);
  }
  .lead {
    margin: 0 0 20px;
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 520px;
  }
  .list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .row {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 18px;
    align-items: baseline;
    padding: 18px 24px;
    border-top: 1px solid var(--border);
    color: var(--text);
    background: var(--bg-panel);
  }
  .row:first-child { border-top: none; }
  .row:hover { background: var(--bg-panel-hover); color: var(--text); }
  .label {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--accent);
  }
  .value {
    font-size: 14.5px;
    color: var(--text-body);
  }
  .arrow {
    font-size: 14px;
    color: var(--text-faint);
  }
</style>
