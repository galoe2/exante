---
// Barra status/ticker sopra l'header: data dell'ultimo run + indici della settimana.
// Alimentata da src/data/market.json (aggiornato ogni sabato dalla pipeline).
import data from '../data/market.json';

const GIORNI = ['DOM', 'LUN', 'MAR', 'MER', 'GIO', 'VEN', 'SAB'];
const d = new Date(data.updated);
const dateLabel = `${GIORNI[d.getUTCDay()]} ${String(d.getUTCDate()).padStart(2, '0')}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${d.getUTCFullYear()}`;

const ov = (data as any).overview ?? {};
const regime = (data as any).pipeline?.regime;

function pct(v: number): string {
  return `${v > 0 ? '+' : ''}${v.toFixed(1).replace('.', ',')}%`;
}

const ticks = [
  { label: 'SPY', value: pct(ov.spy_1w ?? 0), tone: (ov.spy_1w ?? 0) > 0 ? 'pos' : 'neg' },
  { label: 'QQQ', value: pct(ov.qqq_1w ?? 0), tone: (ov.qqq_1w ?? 0) > 0 ? 'pos' : 'neg' },
  ...(ov.realized_vol != null
    ? [{ label: 'VOL', value: `${String(ov.realized_vol).replace('.', ',')}%`, tone: '' }]
    : []),
  ...(regime ? [{ label: 'REGIME', value: regime, tone: 'pos' }] : []),
];
---

<div class="ticker">
  <div class="left">
    <span class="dot">●</span><span>{dateLabel}</span><span class="sep">/</span><span>WEEKLY</span>
  </div>
  <div class="right">
    {
      ticks.map((t) => (
        <span class="tick">
          {t.label} <span class:list={['val', t.tone]}>{t.value}</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 24px;
    border-bottom: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    flex-wrap: wrap;
  }
  .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot { color: var(--accent); }
  .sep { color: var(--border-strong); }
  .right {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .val.pos { color: var(--accent); }
  .val.neg { color: var(--text-muted); }
</style>
