---
import type { CollectionEntry } from 'astro:content';
import { fmtDate, readingMinutes } from '../lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/blog/${post.id}/`;
---

<article>
  <a class="card card-surface" href={href}>
    <span class="chip-rubrica">{post.data.rubrica}</span>
    <h3>{post.data.title}</h3>
    <p>{post.data.abstract}</p>
    <div class="foot">
      <span>{fmtDate(post.data.date).toLowerCase()}</span>
      {
        post.data.sparkline ? (
          <svg width="64" height="18" viewBox="0 0 64 18" style="display:block;">
            <polyline points={post.data.sparkline} fill="none" stroke="var(--accent)" stroke-width="1.5" />
          </svg>
        ) : (
          <span>{readingMinutes(post)} min</span>
        )
      }
    </div>
  </a>
</article>

<style>
  article { display: flex; }
  .card {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--text);
    flex: 1;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    color: var(--text);
    border-color: var(--border-strong);
    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.06), 0 8px 20px rgba(15, 23, 42, 0.08);
  }
  .chip-rubrica { align-self: flex-start; }
  h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  p {
    margin: 0;
    font-size: 14px;
    color: var(--text-body);
    line-height: 1.6;
    flex: 1;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 14px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-faint);
  }
</style>
