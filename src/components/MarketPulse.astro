---
// Market Pulse: top movers e RSI estremi dalla dashboard ETF (src/data/market.json,
// riscritto ogni settimana dalla pipeline). L'overview vive nella card dell'hero.
import data from '../data/market.json';
import { fmtDate } from '../lib/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const updated = fmtDate(new Date(data.updated)).toLowerCase();

function pct(v: number): string {
  return `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1).replace('.', ',')}%`;
}

interface Row {
  t: string;
  d?: string;
  value: string;
  tone: string;
}

const quadrants: { title: string; tone: string; rows: Row[] }[] = [
  {
    title: 'Top gainers · 1 settimana',
    tone: 'up',
    rows: (data.gainers ?? []).map((e: any) => ({ t: e.t, d: e.d, value: pct(e.w1), tone: 'pos' })),
  },
  {
    title: 'Top losers · 1 settimana',
    tone: 'dn',
    rows: (data.losers ?? []).map((e: any) => ({ t: e.t, d: e.d, value: pct(e.w1), tone: 'neg' })),
  },
  {
    title: 'Ipercomprato · RSI',
    tone: 'up',
    rows: (data.overbought ?? []).map((e: any) => ({ t: e.t, d: e.d, value: `${Math.round(e.rsi)}`, tone: 'pos' })),
  },
  {
    title: 'Ipervenduto · RSI',
    tone: 'dn',
    rows: (data.oversold ?? []).map((e: any) => ({ t: e.t, d: e.d, value: `${Math.round(e.rsi)}`, tone: 'neg' })),
  },
].filter((q) => q.rows.length > 0);
---

<div class="section-header" style="margin-bottom:24px;">
  <div class="mono-label">Market Pulse</div>
  <span class="updated">Aggiornato {updated}</span>
</div>

<div class="panel card-surface">
  <div class="quads">
    {
      quadrants.map((q) => (
        <div class="quad">
          <div class:list={['quad-hd', q.tone]}>{q.title}</div>
          {q.rows.map((r) => (
            <div class="row">
              <span class="tk">{r.t}</span>
              <span class="desc">{r.d}</span>
              <span class:list={['val', r.tone]}>{r.value}</span>
            </div>
          ))}
        </div>
      ))
    }
  </div>

  {
    data.comment && (
      <div class="comment-row">
        <p class="comment">{data.comment}</p>
        <a class="section-link" href={`${base}/mercati/`}>La dashboard completa →</a>
      </div>
    )
  }
</div>

<style>
  .updated {
    font-size: 13px;
    color: var(--text-faint);
    font-weight: 500;
    white-space: nowrap;
  }
  .panel { overflow: hidden; }
  .quads {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .quad {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-bottom: 10px;
  }
  .quad:nth-child(2n) { border-right: none; }
  .quad:nth-last-child(-n + 2) { border-bottom: none; }
  .quad-hd {
    font-size: 12.5px;
    font-weight: 700;
    padding: 14px 24px 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .quad-hd.up { color: var(--pos); background: var(--pos-soft); }
  .quad-hd.dn { color: var(--neg); background: var(--neg-soft); }
  .row {
    display: grid;
    grid-template-columns: 58px 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 7px 24px;
  }
  .row:hover { background: var(--bg-panel-hover); }
  .tk { font-size: 13px; font-weight: 700; color: var(--text); }
  .desc {
    font-size: 13px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .val {
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .val.pos { color: var(--pos); }
  .val.neg { color: var(--neg); }
  .comment-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding: 18px 24px;
    background: var(--bg-soft);
  }
  .comment {
    margin: 0;
    font-size: 14px;
    color: var(--text-body);
    line-height: 1.65;
    max-width: 700px;
  }
  @media (max-width: 640px) {
    .quads { grid-template-columns: 1fr; }
    .quad { border-right: none; }
    .quad:nth-last-child(-n + 2) { border-bottom: 1px solid var(--border); }
    .quad:last-child { border-bottom: none; }
  }
</style>
