---
import { getCollection } from 'astro:content';
import { fmtDate, readingMinutes, sortPosts, RUBRICHE, RUBRICA_DESC, rubricaSlug } from '../lib/utils';

interface Props {
  // 'TUTTI' oppure una rubrica
  active: string;
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const all = sortPosts(await getCollection('blog'));
const posts = active === 'TUTTI' ? all : all.filter((p) => p.data.rubrica === active);

const counts: Record<string, number> = { TUTTI: all.length };
for (const p of all) counts[p.data.rubrica] = (counts[p.data.rubrica] ?? 0) + 1;

const filters = ['TUTTI', ...RUBRICHE].map((id) => ({
  id,
  label: `${id.charAt(0)}${id.slice(1).toLowerCase()} · ${counts[id] ?? 0}`,
  href: id === 'TUTTI' ? `${base}/blog/` : `${base}/blog/${rubricaSlug(id)}/`,
}));

const desc = RUBRICA_DESC[active] ?? '';
---

<div class="container page">
  <h1>Blog</h1>
  <p class="lead">Tre rubriche, una disciplina: scrivere prima, verificare poi.</p>

  <div class="filters">
    {
      filters.map((f) => (
        <a class:list={['chip', { active: active === f.id }]} href={f.href}>
          {f.label}
        </a>
      ))
    }
  </div>

  {desc && <p class="rubrica-desc">{desc}</p>}

  {
    posts.length === 0 && (
      <div class="empty-state" style="margin-top:28px;">
        <span class="nota">IN ARRIVO</span>
        <span>Non ci sono ancora articoli in questa rubrica.</span>
      </div>
    )
  }

  <div class="list">
    {
      posts.map((post) => (
        <article>
          <a class="row card-surface" href={`${base}/blog/${post.id}/`}>
            <div class="meta">
              <span class="chip-rubrica">{post.data.rubrica}</span>
              <span class="m">{fmtDate(post.data.date).toLowerCase()}</span>
              <span class="m">{readingMinutes(post)} min</span>
            </div>
            <div class="body">
              <h2>{post.data.title}</h2>
              <p>{post.data.abstract}</p>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</div>

<style>
  .page { padding-top: 64px; padding-bottom: 80px; }
  h1 {
    margin: 0 0 10px;
    font-weight: 800;
    font-size: clamp(34px, 4.5vw, 44px);
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0 0 32px;
    font-size: 16px;
    color: var(--text-muted);
    max-width: 560px;
    line-height: 1.7;
  }
  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .chip {
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    color: var(--text-muted);
    background: var(--bg-soft);
  }
  .chip:hover { color: var(--text); }
  .chip.active {
    color: #fff;
    background: var(--accent);
  }
  .chip.active:hover { color: #fff; }
  .rubrica-desc {
    margin: 22px 0 0;
    font-size: 14px;
    color: var(--text-muted);
    max-width: 640px;
    line-height: 1.65;
    border-left: 3px solid var(--accent);
    padding-left: 14px;
  }
  .list {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(140px, 170px) 1fr;
    gap: 26px;
    padding: 26px 28px;
    color: var(--text);
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .row:hover {
    color: var(--text);
    border-color: var(--border-strong);
    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.06), 0 8px 20px rgba(15, 23, 42, 0.08);
  }
  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
  }
  .meta .m {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-faint);
  }
  .body { min-width: 220px; }
  .body h2 {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .body p {
    margin: 0;
    font-size: 14.5px;
    color: var(--text-body);
    line-height: 1.65;
    max-width: 640px;
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; gap: 12px; }
    .meta { flex-direction: row; align-items: baseline; gap: 14px; }
  }
</style>
