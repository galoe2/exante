---
import Logo from './Logo.astro';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = [
  { id: 'home', label: 'Home', href: `${base}/` },
  { id: 'blog', label: 'Blog', href: `${base}/blog/` },
  { id: 'mercati', label: 'Mercati', href: `${base}/mercati/` },
  { id: 'lab', label: 'Lab', href: `${base}/lab/` },
  { id: 'contatti', label: 'Contatti', href: `${base}/contatti/` },
];
---

<header>
  <div class="container inner">
    <a class="brand" href={`${base}/`}>
      <Logo size={30} />
      <span class="wordmark">Ex Ante</span>
    </a>
    <nav>
      {
        items.map((item) => (
          <a class:list={['nav-item', { active: active === item.id }]} href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    padding-top: 15px;
    padding-bottom: 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .wordmark {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  nav {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .nav-item {
    font-size: 14px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 8px;
    color: var(--text-muted);
  }
  .nav-item:hover { color: var(--text); background: var(--bg-panel-hover); }
  .nav-item.active {
    color: var(--accent);
    background: var(--accent-soft);
  }
</style>
