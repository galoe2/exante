---
import { loadNews, NEWS_SOURCES, sourceName, fmtOra, fmtGiorno, fmtQuando, giornoKey } from '../lib/news';

interface Props {
  // 'tutte' oppure l'id di una fonte
  active: string;
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const news = loadNews();
const counts: Record<string, number> = { tutte: news.items.length };
for (const it of news.items) counts[it.source] = (counts[it.source] ?? 0) + 1;

const filters = [{ id: 'tutte', name: 'Tutte' }, ...NEWS_SOURCES].map((s) => ({
  id: s.id,
  label: `${s.name} · ${counts[s.id] ?? 0}`,
  href: s.id === 'tutte' ? `${base}/news/` : `${base}/news/${s.id}/`,
}));

const items = active === 'tutte' ? news.items : news.items.filter((it) => it.source === active);

// Raggruppa per giorno (ora italiana), dal più recente
const giorni: { key: string; label: string; items: typeof items }[] = [];
for (const it of items) {
  const key = giornoKey(it.date);
  let g = giorni.find((x) => x.key === key);
  if (!g) {
    g = { key, label: fmtGiorno(it.date), items: [] };
    giorni.push(g);
  }
  g.items.push(it);
}

const viaGoogle = news.sources.filter((s) => s.via).map((s) => s.name);
---

<div class="container page">
  <h1>News</h1>
  <p class="lead">
    I titoli principali su mercati ed economia da Bloomberg, Reuters, CNBC, MarketWatch, Fed e
    BCE, aggiornati ogni giorno. Ogni titolo porta all'articolo originale.
  </p>
  {news.updated && <p class="updated">Aggiornato il {fmtQuando(news.updated).replace(', ', ' alle ')}</p>}

  <div class="filters" role="navigation" aria-label="Filtra per fonte">
    {
      filters.map((f) => (
        <a class:list={['chip', { active: active === f.id }]} href={f.href} aria-current={active === f.id ? 'page' : undefined}>
          {f.label}
        </a>
      ))
    }
  </div>

  {
    items.length === 0 && (
      <div class="empty-state" style="margin-top:28px;">
        <span class="nota">NEWS</span>
        <span>
          {active === 'tutte'
            ? 'In questo momento non ci sono titoli disponibili: si aggiornano ogni mattina e a metà giornata.'
            : `Nessun titolo recente da ${sourceName(active)}.`}
        </span>
      </div>
    )
  }

  {
    giorni.map((g) => (
      <section class="giorno" aria-label={g.label}>
        <h2>{g.label}</h2>
        <ul class="lista card-surface">
          {g.items.map((it) => (
            <li>
              <time datetime={it.date}>{fmtOra(it.date)}</time>
              <span class="fonte">
                {sourceName(it.source)}
                <span class="sezione"> · {it.section}</span>
              </span>
              <a class="titolo" href={it.link} target="_blank" rel="noopener nofollow" lang="en">
                {it.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="nota-fonti">
    Titoli e link appartengono ai rispettivi editori: Ex Ante non riproduce il testo degli
    articoli. Reuters non pubblica più feed RSS, i suoi titoli arrivano dalla ricerca di Google
    News{viaGoogle.includes('Bloomberg') ? ', come oggi quelli di Bloomberg' : ''}.
  </p>
</div>

<style>
  .page { padding-top: 64px; padding-bottom: 80px; }
  h1 {
    margin: 0 0 10px;
    font-weight: 800;
    font-size: clamp(34px, 4.5vw, 44px);
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0;
    font-size: 16px;
    color: var(--text-muted);
    max-width: 640px;
    line-height: 1.7;
  }
  .updated {
    margin: 10px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-faint);
  }
  .filters {
    margin-top: 28px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .chip {
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    color: var(--text-muted);
    background: var(--bg-soft);
  }
  .chip:hover { color: var(--text); }
  .chip.active { color: #fff; background: var(--accent); }
  .chip.active:hover { color: #fff; }
  .giorno { margin-top: 36px; }
  .giorno h2 {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  .lista li {
    display: grid;
    grid-template-columns: 52px 168px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 14px 22px;
    border-top: 1px solid var(--border);
  }
  .lista li:first-child { border-top: none; }
  time {
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
  }
  .fonte {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
  }
  .sezione { font-weight: 500; color: var(--text-faint); }
  .titolo {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text);
  }
  .titolo:hover { color: var(--accent); }
  .nota-fonti {
    margin: 32px 0 0;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--text-faint);
    max-width: 640px;
  }
  @media (max-width: 640px) {
    .lista li {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 4px 12px;
      padding: 14px 18px;
    }
    .titolo { grid-column: 1 / -1; }
  }
</style>
