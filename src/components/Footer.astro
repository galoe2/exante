---
import Logo from './Logo.astro';
import market from '../data/market.json';
import { fmtDate } from '../lib/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pipeline = (market as any).pipeline;
const pipelineLabel = pipeline?.etfs
  ? `Dati aggiornati al ${fmtDate(new Date(market.updated)).toLowerCase()} · ${pipeline.etfs} ETF monitorati`
  : '';
const items = [
  { label: 'Home', href: `${base}/` },
  { label: 'Blog', href: `${base}/blog/` },
  { label: 'Mercati', href: `${base}/mercati/` },
  { label: 'Lab', href: `${base}/lab/` },
  { label: 'Contatti', href: `${base}/contatti/` },
];
const year = new Date().getFullYear();
---

<footer>
  <div class="container grid">
    <div>
      <div class="brand"><Logo size={26} /><span>Ex Ante</span></div>
      <div class="tagline">Prima che accada.<br />Mercati, modelli, dati.</div>
    </div>
    <div class="nav">
      {items.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="disclaimer">
      I contenuti di questo sito hanno scopo informativo e riflettono opinioni personali
      dell'autore: non costituiscono consulenza finanziaria né sollecitazione all'investimento.
    </div>
  </div>
  <div class="subbar-wrap">
    <div class="container subbar">
      <span>© {year} Ex Ante</span>
      {pipelineLabel && <span>{pipelineLabel}</span>}
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    margin-top: 24px;
  }
  .grid {
    padding-top: 44px;
    padding-bottom: 36px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 36px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .tagline {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 280px;
  }
  .nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .nav a {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
    width: max-content;
  }
  .nav a:hover { color: var(--text); }
  .disclaimer {
    font-size: 12.5px;
    color: var(--text-faint);
    line-height: 1.75;
    max-width: 340px;
  }
  .subbar-wrap { border-top: 1px solid var(--border); }
  .subbar {
    padding-top: 14px;
    padding-bottom: 14px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: var(--text-faint);
  }
</style>
