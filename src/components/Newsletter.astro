---
// Variante "wide" (banda in home) o "compact" (articolo, contatti).
// Il form è solo UI: collegare action a un provider (Buttondown/MailerLite/ConvertKit).
interface Props {
  variant?: 'wide' | 'compact';
}
const { variant = 'compact' } = Astro.props;
---

<div class:list={['box', variant]}>
  <div class="content">
    <div class="title">La lettura dei mercati, ogni settimana nella tua inbox.</div>
    <div class="sub">Una email a settimana, zero rumore. Disiscrizione in un click.</div>
  </div>
  <form class="form" action="#" method="post">
    <input type="email" name="email" placeholder="la-tua-email@esempio.it" required />
    <button type="submit" class="btn-primary" style="padding:12px 22px;">Iscriviti</button>
  </form>
</div>

<style>
  .box {
    background: var(--bg-soft);
    border-radius: 20px;
  }
  .box.wide {
    padding: 36px clamp(24px, 4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .box.compact {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .wide .content { max-width: 520px; }
  .title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .compact .title { font-size: 17.5px; }
  .sub {
    font-size: 14px;
    color: var(--text-muted);
    margin-top: 8px;
  }
  .compact .sub { margin-top: 0; }
  .form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  input {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-family: var(--sans);
    font-size: 14px;
    padding: 12px 14px;
    outline: none;
  }
  input:focus { border-color: var(--accent); }
  .wide input { width: min(280px, 60vw); }
  .compact input { flex: 1; min-width: 200px; }
</style>
