---
// Newsletter: work in progress — il form verrà attivato quando ci sarà
// un provider collegato (Buttondown/MailerLite/ConvertKit).
interface Props {
  variant?: 'wide' | 'compact';
}
const { variant = 'compact' } = Astro.props;
---

<div class:list={['box', variant]}>
  <div class="content">
    <div class="title">La lettura dei mercati, ogni settimana nella tua inbox.</div>
    <div class="sub">Una email a settimana, zero rumore. Disiscrizione in un click.</div>
  </div>
  <span class="wip">Newsletter in preparazione</span>
</div>

<style>
  .box {
    background: var(--bg-soft);
    border-radius: 20px;
  }
  .box.wide {
    padding: 36px clamp(24px, 4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .box.compact {
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .wide .content { max-width: 520px; }
  .title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .compact .title { font-size: 17.5px; }
  .sub {
    font-size: 14px;
    color: var(--text-muted);
    margin-top: 8px;
  }
  .compact .sub { margin-top: 0; }
  .wip {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 8px 16px;
    border-radius: 999px;
    white-space: nowrap;
  }
</style>
